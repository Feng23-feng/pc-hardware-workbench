{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skilldock-chat-context.schema.json",
  "title": "SkillDock compact chat handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "channel_id",
    "objective",
    "summary",
    "messages"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "channel_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,199}$"
    },
    "source_session_ref": {
      "type": "string",
      "maxLength": 256
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "summary": {
      "type": "string",
      "maxLength": 4000
    },
    "messages": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "text"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
          },
          "role": {
            "enum": ["user", "agent"]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
