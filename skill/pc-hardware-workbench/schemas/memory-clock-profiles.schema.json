{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pc-hardware-workbench.local/schemas/memory-clock-profiles.schema.json",
  "title": "Memory clock display profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profiles"],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "gpu",
          "raw_field",
          "raw_tool",
          "display_tool",
          "display_multiplier",
          "data_rate_multiplier",
          "bus_width_bits",
          "clock_basis",
          "sources",
          "constraints"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,100}$"
          },
          "status": {
            "enum": ["verified-local", "provisional", "deprecated"]
          },
          "gpu": {
            "type": "object",
            "additionalProperties": false,
            "required": ["vendor", "model", "aliases", "form_factor", "memory_type"],
            "properties": {
              "vendor": {"type": "string", "minLength": 1, "maxLength": 80},
              "model": {"type": "string", "minLength": 1, "maxLength": 160},
              "aliases": {
                "type": "array",
                "maxItems": 16,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1, "maxLength": 160}
              },
              "form_factor": {"enum": ["laptop", "desktop", "other"]},
              "memory_type": {"type": "string", "minLength": 1, "maxLength": 40}
            }
          },
          "raw_field": {
            "type": "object",
            "additionalProperties": false,
            "required": ["metric", "source_column_pattern", "clock_basis"],
            "properties": {
              "metric": {"type": "string", "minLength": 1, "maxLength": 160},
              "source_column_pattern": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "clock_basis": {
                "enum": ["unknown", "physical", "command", "effective", "vendor-scaled"]
              }
            }
          },
          "raw_tool": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "accepted_identities"],
            "properties": {
              "name": {"type": "string", "minLength": 1, "maxLength": 120},
              "version": {"type": "string", "minLength": 1, "maxLength": 80},
              "accepted_identities": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1, "maxLength": 200}
              }
            }
          },
          "display_tool": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "label", "accepted_identities"],
            "properties": {
              "name": {"type": "string", "minLength": 1, "maxLength": 120},
              "version": {"type": "string", "minLength": 1, "maxLength": 80},
              "label": {"type": "string", "minLength": 1, "maxLength": 160},
              "accepted_identities": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1, "maxLength": 200}
              }
            }
          },
          "display_multiplier": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 64
          },
          "data_rate_multiplier": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 128
          },
          "bus_width_bits": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16384
          },
          "official_data_rate_gbps": {
            "type": ["number", "null"],
            "exclusiveMinimum": 0,
            "maximum": 1000
          },
          "official_bandwidth_gbps": {
            "type": ["number", "null"],
            "exclusiveMinimum": 0,
            "maximum": 100000
          },
          "clock_basis": {
            "enum": [
              "unknown",
              "physical",
              "command",
              "effective",
              "vendor-scaled-derived"
            ]
          },
          "sources": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hardware", "tool_mapping"],
            "properties": {
              "hardware": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {"type": "string", "format": "uri"}
              },
              "tool_mapping": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {"type": "string", "minLength": 1, "maxLength": 1000}
              },
              "verified_at": {"type": "string", "minLength": 10, "maxLength": 40}
            }
          },
          "constraints": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "exact_gpu_required",
              "exact_raw_field_required",
              "exact_tool_required",
              "cross_generation_allowed"
            ],
            "properties": {
              "exact_gpu_required": {"const": true},
              "exact_raw_field_required": {"const": true},
              "exact_tool_required": {"const": true},
              "cross_generation_allowed": {"const": false}
            }
          }
        }
      }
    }
  }
}
