{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "panel-ui-state.schema.json",
  "title": "SkillDock UI State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "turn_summary",
    "current_goal",
    "status",
    "judgement",
    "question",
    "recommendation",
    "evidence",
    "uncertainty",
    "recommendations",
    "priorityAction",
    "actions",
    "artifact_refs",
    "blocks"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.2"
    },
    "turn_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "current_goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "status": {
      "type": "string",
      "enum": [
        "needs_input",
        "ready",
        "blocked"
      ]
    },
    "judgement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "question": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "prompt",
            "options",
            "allow_free_text"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,64}$"
            },
            "prompt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "allow_free_text": {
              "type": "boolean"
            },
            "options": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "label",
                  "description"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]{1,48}$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 48
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 160
                  }
                }
              }
            }
          }
        }
      ]
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "option_id"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "maxLength": 240
        },
        "option_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "detail",
          "source",
          "relation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,64}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "detail": {
            "type": "string",
            "maxLength": 280
          },
          "source": {
            "type": "string",
            "enum": [
              "user_reported",
              "agent_inference",
              "observed_current",
              "historical"
            ]
          },
          "relation": {
            "type": "string",
            "enum": [
              "supports",
              "conflicts",
              "context"
            ]
          }
        }
      }
    },
    "uncertainty": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 280
      }
    },
    "recommendations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "detail",
          "risk",
          "evidence_goal"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,64}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 520
          },
          "risk": {
            "type": "string",
            "enum": [
              "low"
            ]
          },
          "evidence_goal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    },
    "priorityAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "detail"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 520
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "kind",
          "content"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,64}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48
          },
          "kind": {
            "type": "string",
            "enum": [
              "copy"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "artifact_refs": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "blocks": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/block"
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "mime",
        "title",
        "relative_path",
        "sha256",
        "source_evidence_ids",
        "created_at",
        "safeToEmbed",
        "size"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,80}$"
        },
        "kind": {
          "const": "chart"
        },
        "mime": {
          "const": "image/svg+xml"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^(?![A-Za-z]:[\\\\/]|/)(?!.*\\.\\.)(?!.*\\\\)[^/]+/[^/]+\\.svg$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_evidence_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,80}$"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "safeToEmbed": {
          "const": true
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5242880
        }
      }
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "title", "text"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,80}$"
            },
            "type": {
              "const": "markdown"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "title", "items"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,80}$"
            },
            "type": {
              "const": "metrics"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "value", "unit", "source_column"],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "unit": {
                    "type": "string",
                    "maxLength": 16
                  },
                  "source_column": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "title", "artifact_ref", "alt"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,80}$"
            },
            "type": {
              "const": "chart"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "artifact_ref": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,80}$"
            },
            "alt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "title", "columns", "rows"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,80}$"
            },
            "type": {
              "const": "table"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "columns": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "rows": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 120
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "title", "text", "tone", "collapsed"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,80}$"
            },
            "type": {
              "const": "callout"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "tone": {
              "enum": ["info", "warning", "neutral"]
            },
            "collapsed": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "title", "artifact_ref", "label"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,80}$"
            },
            "type": {
              "const": "artifact-download"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "artifact_ref": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,80}$"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 48
            }
          }
        }
      ]
    }
  }
}
