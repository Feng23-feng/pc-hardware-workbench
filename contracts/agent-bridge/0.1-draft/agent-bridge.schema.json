{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-bridge-0.1-draft.schema.json",
  "title": "SkillDock Agent Bridge 0.1 draft",
  "oneOf": [
    {
      "$ref": "#/$defs/health"
    },
    {
      "$ref": "#/$defs/capabilities"
    },
    {
      "$ref": "#/$defs/sessionResponse"
    },
    {
      "$ref": "#/$defs/turnResponse"
    },
    {
      "$ref": "#/$defs/cancelResponse"
    },
    {
      "$ref": "#/$defs/errorResponse"
    }
  ],
  "$defs": {
    "protocolVersion": {
      "const": "0.1-draft"
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "protocol_version"],
      "properties": {
        "ok": {
          "const": true
        },
        "protocol_version": {
          "$ref": "#/$defs/protocolVersion"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "implementation",
        "capabilities",
        "limitations"
      ],
      "properties": {
        "protocol_version": {
          "$ref": "#/$defs/protocolVersion"
        },
        "implementation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text_input", "session_create"],
          "properties": {
            "text_input": {
              "const": true
            },
            "session_create": {
              "const": true
            },
            "session_resume": {
              "type": "boolean"
            },
            "session_naming": {
              "type": "boolean"
            },
            "structured_output": {
              "type": "boolean"
            },
            "streaming": {
              "const": false
            },
            "cancellation": {
              "type": "boolean"
            },
            "approvals": {
              "const": false
            },
            "active_attach": {
              "const": false
            }
          }
        },
        "limitations": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "created_at"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,255}$"
        },
        "name": {
          "type": ["string", "null"],
          "maxLength": 120
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "sessionResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session"],
      "properties": {
        "session": {
          "$ref": "#/$defs/session"
        }
      }
    },
    "turnRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "turn_id",
        "packet",
        "output_schema"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "turn_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 255
        },
        "packet": {
          "type": "object"
        },
        "output_schema": {
          "type": ["object", "null"]
        }
      }
    },
    "turnResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn_id", "status", "output"],
      "properties": {
        "turn_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 255
        },
        "status": {
          "const": "completed"
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "structured"],
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 2000000
            },
            "structured": {
              "type": ["object", "null"]
            }
          }
        }
      }
    },
    "cancelResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cancelled"],
      "properties": {
        "cancelled": {
          "const": true
        }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["classification", "code", "message"],
          "properties": {
            "classification": {
              "enum": [
                "unavailable",
                "blocked",
                "auth",
                "permission",
                "protocol"
              ]
            },
            "code": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9._-]{1,119}$"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        }
      }
    }
  }
}
